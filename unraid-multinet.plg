<?xml version="1.0" standalone="yes"?>

<!--
unraid-multinet — additional Docker networks per container, persisted in
the container's own template.
https://github.com/kmbrimble/unraid-multinet

Not distributed via Community Applications. Install by URL from
Plugins -> Install Plugin, using this file's raw.githubusercontent.com URL.
See README.md and CLAUDE.md for design and the release process.
-->

<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-multinet">
<!ENTITY author    "kmbrimble">
<!ENTITY version   "0.2.0">
<!ENTITY launch    "Settings/MultiNet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/kmbrimble/unraid-multinet/main/unraid-multinet.plg">
<!ENTITY gitURL    "https://github.com/kmbrimble/unraid-multinet/releases/download/v&version;">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY md5       "7ab18342e312b4c31cf34e8d8ddbc9f1">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="https://github.com/kmbrimble/unraid-multinet" min="7.0" icon="sitemap">

<CHANGES>
###0.2.0
- Fixed: the Networks/Containers UI was never reachable as its own Docker tab — `Menu="Docker:3"`
  just got concatenated onto the bottom of the Docker page's own content, since that page's
  `Menu="Docker:1"` anchor (DockerContainers.page) sets `Tabs="false"` and an untabbed menu
  group renders every page in it in sequence, not as separate tabs. Confirmed live in a real
  browser. Moved to its own page under Settings (`Settings/MultiNet`, same pattern
  unraid-secretsman's SecretsMan.page uses), with a small button injected on the Docker page
  (next to Add Container/Start All) linking to it — nothing else from the plugin renders on the
  Docker page itself now. `&launch;` updated to match.
- Fixed: the Add/Update Container form's "Additional networks" section always showed "could not
  reach the plugin endpoint" — confirmed live. Root cause: Unraid's global CSRF enforcement
  (`local_prepend.php`) silently 0-byte's any plugin POST missing a valid token, and the
  injector's own `XMLHttpRequest` calls (unlike MultiNet.page's jQuery calls, which get this for
  free via the global `$.ajaxPrefilter`) never sent one. Fixed by sending the page's global
  `csrf_token` JS var as both the `X-CSRF-Token` header and a `csrf_token` body field on every
  request the injector makes. Verified against the real host: an authenticated session without
  the token gets a 200 with an empty body (`csrf_terminate()`'s exact shape); the same session
  with the header gets the real JSON response.
- Polish: the container matrix on the Settings page is now a real table (container / primary /
  path / status / additional networks / actions columns) instead of a stack of loose rows.
###0.1.0
- First release. Additional Docker networks per container, persisted in the container's own
  template (ExtraParams for user-defined primaries, PostArgs for bridge/host/none/container:*
  primaries — see README.md and CLAUDE.md for the full design). Docker → Networks tab
  (network CRUD, container matrix with Save/Apply now), and an "Additional networks" section
  injected into the Add/Update Container form below the Fixed MAC address row.
</CHANGES>

<FILE Name="&plgPATH;/&name;-&version;.txz">
<URL>&gitURL;/&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -e

# No separate md5 re-check here (0.1.0 -> 0.2.0 had one, reading a
# versionless sidecar file — dropped after a real upgrade failure: the
# plugin manager's own file-fetch step (dynamix.plugin.manager/scripts/plugin,
# "if file already exists ... do not overwrite") never rewrites a FILE with
# no declared <MD5>/<SHA256> once a file already sits at that path, so the
# sidecar stayed stuck at 0.1.0's value across the upgrade and the custom
# check failed on a perfectly good 0.2.0 download. The <MD5> tag on the
# .txz FILE block above IS verified by the plugin manager itself before
# this script ever runs (same function, the branch that DOES re-fetch on a
# mismatch) — trust that instead of re-deriving it here. Same lesson as
# the CSRF check in include/api.php: don't duplicate a guarantee the
# platform already enforces upstream of this code.

upgradepkg --install-new &plgPATH;/&name;-&version;.txz

# Unpacks to &emhttp; (include/, *.page, multinet-core.js, README.md) —
# .page files must sit in the plugin's installed ROOT (Unraid's page
# loader globs plugins/*/*.page non-recursively).

mkdir -p &plgPATH;
if [[ ! -f &plgPATH;/state.json ]]; then
  echo '{}' > &plgPATH;/state.json
fi

echo "unraid-multinet: install complete"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Templates are untouched by uninstall, deliberately: any additional-network
# fragment already written into a template's ExtraParams/PostArgs keeps
# taking effect on its own (dockerMan's own xmlToCommand() applies it, no
# plugin involvement needed) — see README.md "Limitations". Only the
# installed plugin tree is removed; state.json (the sidecar that tells the
# plugin's own blocks apart from hand-written ones) is deliberately KEPT so
# a future reinstall recognises its own prior work instead of treating
# every existing block as manually managed.
removepkg &name;-&version;
rm -rf &emhttp;

echo "unraid-multinet: removed. Templates and &plgPATH;/state.json were left untouched."
</INLINE>
</FILE>

</PLUGIN>
