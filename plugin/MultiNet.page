<?php
$pluginRoot = '/plugins/unraid-multinet';
?>
<script src="<?=$pluginRoot?>/multinet-core.js"></script>
<style>
#mn-networks table, #mn-containers table { width: 100%; }
#mn-networks td, #mn-containers td { vertical-align: top; }
.mn-chip { padding: 2px 8px; border-radius: 10px; font-size: 0.85em; color: #fff; }
.mn-chip-sync { background: #2e7d32; }
.mn-chip-drift { background: #c77700; }
.mn-chip-stopped { background: #757575; }
.mn-chip-manual { background: #b00020; }
.mn-row-fields input[type=text] { width: 95%; }
.mn-fragment { font-family: monospace; font-size: 0.85em; word-break: break-all; color: #888; }
.mn-err { color: #c62828; }
</style>

<table class="tablesorter shift">
  <thead><tr><th>Networks</th></tr></thead>
</table>
<div id="mn-networks"><p class="notice">Loading&hellip;</p></div>

<table class="tablesorter shift">
  <thead><tr><th>Containers</th></tr></thead>
</table>
<p><button id="mn-apply-all" type="button">Apply all</button></p>
<div id="mn-containers"><p class="notice">Loading&hellip;</p></div>

<script>
var API = '<?=$pluginRoot?>/include/api.php';

function mnBanner(msg, isError) {
  if (!msg) return;
  try {
    if (window.swal) { swal({title: isError ? 'Error' : 'Success', text: msg, type: isError ? 'error' : 'success', confirmButtonText: 'OK'}); return; }
  } catch (e) {}
  alert(msg);
}

function mnPost(action, data, done) {
  data = data || {};
  data.action = action;
  $.post(API, data, function (resp) { done(resp); }, 'json').fail(function () {
    mnBanner('unraid-multinet: request failed — check the browser console', true);
  });
}

function h(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

// ---- Networks table -----------------------------------------------------

function renderNetworks(networks) {
  var rows = networks.map(function (n) {
    var subnets = n.subnets.map(function (s) {
      return h(s.subnet) + (s.gateway ? ' gw ' + h(s.gateway) : '') + (s.ip_range ? ' range ' + h(s.ip_range) : '');
    }).join('<br>') || '&mdash;';
    var containers = n.containers.map(function (c) { return h(c.name) + (c.ip ? ' (' + h(c.ip) + ')' : ''); }).join('<br>') || '&mdash;';
    var protectedNet = /^(bridge|host|none)$/.test(n.name) || /^br\d/.test(n.name);
    var del = protectedNet ? '' : '<button type="button" onclick="mnDeleteNetwork(\'' + h(n.name) + '\')">Delete</button>';
    return '<tr><td>' + h(n.name) + '</td><td>' + h(n.driver) + '</td><td>' + subnets + '</td><td>' + containers + '</td><td>' + del + '</td></tr>';
  }).join('');
  $('#mn-networks').html(
    '<table class="tablesorter"><thead><tr><th>Name</th><th>Driver</th><th>Subnet</th><th>Containers</th><th></th></tr></thead><tbody>' + rows + '</tbody></table>' +
    '<h4>Create network</h4>' +
    '<table class="new"><tr>' +
    '<td>Name</td><td><input type="text" id="mn-net-name" class="narrow"></td>' +
    '<td>Driver</td><td><select id="mn-net-driver"><option value="bridge">bridge</option><option value="ipvlan">ipvlan</option><option value="macvlan">macvlan</option></select></td>' +
    '<td>Subnet</td><td><input type="text" id="mn-net-subnet" class="narrow" placeholder="172.30.0.0/24"></td>' +
    '<td>Gateway</td><td><input type="text" id="mn-net-gateway" class="narrow" placeholder="172.30.0.1"></td>' +
    '<td>IP range</td><td><input type="text" id="mn-net-iprange" class="narrow" placeholder="172.30.0.128/25"></td>' +
    '<td>Parent (ipvlan/macvlan)</td><td><input type="text" id="mn-net-parent" class="narrow" placeholder="eth0"></td>' +
    '<td><label><input type="checkbox" id="mn-net-internal"> internal</label></td>' +
    '<td><button type="button" onclick="mnCreateNetwork()">Create</button></td>' +
    '</tr></table><span id="mn-net-err" class="mn-err"></span>'
  );
}

function loadNetworks() {
  mnPost('networks', {}, function (resp) {
    if (!resp.ok) { $('#mn-networks').html('<p class="mn-err">' + h(resp.error) + '</p>'); return; }
    renderNetworks(resp.networks);
  });
}

function mnCreateNetwork() {
  mnPost('network_create', {
    name: $('#mn-net-name').val(),
    driver: $('#mn-net-driver').val(),
    subnet: $('#mn-net-subnet').val(),
    gateway: $('#mn-net-gateway').val(),
    ip_range: $('#mn-net-iprange').val(),
    parent: $('#mn-net-parent').val(),
    internal: $('#mn-net-internal').is(':checked') ? '1' : '0'
  }, function (resp) {
    if (!resp.ok) { $('#mn-net-err').text(resp.error); return; }
    $('#mn-net-err').text('');
    loadNetworks();
  });
}

function mnDeleteNetwork(name) {
  if (!confirm('Delete network ' + name + '?')) return;
  mnPost('network_delete', {name: name}, function (resp) {
    if (!resp.ok) { mnBanner(resp.error, true); return; }
    loadNetworks();
  });
}

// ---- Containers matrix ----------------------------------------------------

var mnContainers = {}; // name -> container object (with in-progress edits)

function mnRowHtml(ctnName, row, idx, macDisabled) {
  row = row || {network: '', ip: '', alias: '', mac: ''};
  return '<div class="mn-row-fields" data-idx="' + idx + '" style="margin-bottom:4px">' +
    '<input type="text" class="mn-f-network" placeholder="network" value="' + h(row.network) + '" style="width:20%" onchange="mnRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="mn-f-ip" placeholder="ip (optional)" value="' + h(row.ip) + '" style="width:20%" onchange="mnRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="mn-f-alias" placeholder="alias (optional)" value="' + h(row.alias) + '" style="width:20%" onchange="mnRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="mn-f-mac" placeholder="mac (optional)" value="' + h(row.mac) + '" style="width:20%"' + (macDisabled ? ' disabled title="MAC is not supported on the PostArgs path"' : '') + ' onchange="mnRowChanged(\'' + h(ctnName) + '\')">' +
    '<button type="button" onclick="mnRemoveRow(\'' + h(ctnName) + '\', ' + idx + ')">Remove</button>' +
    '</div>';
}

function mnStatusChip(c) {
  if (!c.running) return '<span class="mn-chip mn-chip-stopped">not running</span>';
  if (c.manually_managed) return '<span class="mn-chip mn-chip-manual">manually managed</span>';
  var desiredNets = c.rows.map(function (r) { return r.network; });
  var liveNets = Object.keys(c.live_networks).filter(function (n) { return n !== c.primary.split(':')[0]; });
  var inSync = desiredNets.length === liveNets.length && desiredNets.every(function (n) { return liveNets.indexOf(n) !== -1; });
  return inSync ? '<span class="mn-chip mn-chip-sync">in-sync</span>' : '<span class="mn-chip mn-chip-drift">drift</span>';
}

function mnRenderContainer(c) {
  var macDisabled = c.path === 'post';
  var rowsHtml = c.rows.map(function (r, i) { return mnRowHtml(c.name, r, i, macDisabled); }).join('');
  var fragment = mnComputeFragment(c);
  var warn = c.manually_managed ? '<p class="mn-err">This container\'s ' + (c.path === 'extra' ? 'ExtraParams' : 'PostArgs') + ' already contains a network block this plugin did not write &mdash; refusing to rewrite it. Remove it by hand first, or use the other path.</p>' : '';
  return '<div id="mn-ctn-' + h(c.name) + '" style="border-bottom:1px solid #444; padding:8px 0">' +
    '<b>' + h(c.name) + '</b> &mdash; primary <code>' + h(c.primary) + (c.primary_ip ? ' ' + h(c.primary_ip) : '') + (c.primary_mac ? ' ' + h(c.primary_mac) : '') + '</code> ' +
    'path: <code>' + h(c.path) + '</code> ' + mnStatusChip(c) +
    warn +
    '<div class="mn-rows">' + rowsHtml + '</div>' +
    '<button type="button" onclick="mnAddRow(\'' + h(c.name) + '\')">Add network</button> ' +
    '<button type="button" onclick="mnSave(\'' + h(c.name) + '\')">Save</button> ' +
    '<button type="button" onclick="mnApply(\'' + h(c.name) + '\')">Apply now</button>' +
    '<div class="mn-fragment" id="mn-frag-' + h(c.name) + '">' + h(fragment) + '</div>' +
    '</div>';
}

function mnComputeFragment(c) {
  if (!window.multinet) return '';
  if (c.path === 'extra') {
    return multinet.buildNetworkRun(c.primary, c.rows, c.primary_mac || null, !!c.primary_mac_supported);
  }
  var chain = multinet.buildConnectChain(c.name, c.rows);
  return chain === '' ? '' : '&& ' + chain;
}

function mnReadRows(ctnName) {
  var rows = [];
  $('#mn-ctn-' + ctnName + ' .mn-row-fields').each(function () {
    var net = $(this).find('.mn-f-network').val().trim();
    if (!net) return;
    rows.push({
      network: net,
      ip: $(this).find('.mn-f-ip').val().trim() || null,
      alias: $(this).find('.mn-f-alias').val().trim() || null,
      mac: $(this).find('.mn-f-mac').val().trim() || null
    });
  });
  return rows;
}

function mnRowChanged(ctnName) {
  var c = mnContainers[ctnName];
  c.rows = mnReadRows(ctnName);
  $('#mn-frag-' + ctnName).text(mnComputeFragment(c));
}

function mnAddRow(ctnName) {
  var c = mnContainers[ctnName];
  c.rows.push({network: '', ip: '', alias: '', mac: ''});
  $('#mn-ctn-' + ctnName).replaceWith(mnRenderContainer(c));
}

function mnRemoveRow(ctnName, idx) {
  var c = mnContainers[ctnName];
  c.rows.splice(idx, 1);
  $('#mn-ctn-' + ctnName).replaceWith(mnRenderContainer(c));
}

function mnSave(ctnName) {
  var c = mnContainers[ctnName];
  c.rows = mnReadRows(ctnName);
  mnPost('save', {name: ctnName, rows: JSON.stringify(c.rows)}, function (resp) {
    if (!resp.ok) { mnBanner(resp.error, true); return; }
    mnBanner('Saved. ' + (resp.path === 'extra' ? 'ExtraParams' : 'PostArgs') + ' updated in the template.', false);
    loadContainers();
  });
}

function mnApply(ctnName) {
  mnPost('apply', {name: ctnName}, function (resp) {
    if (!resp.ok) {
      var msg = resp.error || (resp.actions || []).filter(function (a) { return !a.ok; }).map(function (a) { return a.op + ' ' + a.network + ': ' + a.error; }).join('; ');
      mnBanner(msg, true);
    } else {
      mnBanner('Applied.', false);
    }
    loadContainers();
  });
}

function mnApplyAll() {
  var names = Object.keys(mnContainers);
  var next = function () {
    if (!names.length) { loadContainers(); return; }
    var n = names.shift();
    mnPost('apply', {name: n}, function () { next(); });
  };
  next();
}

function renderContainers(containers) {
  mnContainers = {};
  containers.forEach(function (c) { mnContainers[c.name] = c; });
  $('#mn-containers').html(containers.map(mnRenderContainer).join(''));
}

function loadContainers() {
  mnPost('containers', {}, function (resp) {
    if (!resp.ok) { $('#mn-containers').html('<p class="mn-err">' + h(resp.error) + '</p>'); return; }
    renderContainers(resp.containers);
  });
}

$(function () {
  loadNetworks();
  loadContainers();
  $('#mn-apply-all').on('click', mnApplyAll);
});
</script>
