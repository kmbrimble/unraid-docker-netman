Link="nav-user"
Markdown="false"
---
<style>
.mn-block { margin: 0.5em 0; }
.mn-block .mn-row { display:flex; gap:6px; margin-bottom:4px; align-items:center; }
.mn-block .mn-row input[type=text] { width: 22%; }
.mn-block .mn-frag { font-family: monospace; font-size: 0.85em; color: #888; word-break: break-all; }
.mn-block .mn-err { color: #c62828; }
</style>
<script>
(function () {
  // Only acts on the Docker container create/update forms. Everything
  // here is defensive: any failure logs to the console and the section
  // shows an error (or is simply absent) rather than ever blocking the
  // real form submit — see docs/SPEC.md deliverable A.1.
  if (!/^\/Docker\/(AddContainer|UpdateContainer)/.test(location.pathname)) return;

  var API = '/plugins/unraid-multinet/include/api.php';
  var CORE = '/plugins/unraid-multinet/multinet-core.js';

  function loadCore(cb) {
    if (window.multinet) { cb(); return; }
    var s = document.createElement('script');
    s.src = CORE;
    s.onload = cb;
    s.onerror = function () { console.error('unraid-multinet: failed to load multinet-core.js'); };
    document.head.appendChild(s);
  }

  function reservedNetworks(primary) {
    var r = ['bridge', 'host', 'none'];
    if (primary) r.push(primary);
    return r;
  }

  function fetchNetworks(cb) {
    var xhr = new XMLHttpRequest();
    xhr.open('POST', API, true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function () {
      try {
        var resp = JSON.parse(xhr.responseText);
        cb(resp.ok ? resp.networks : null);
      } catch (e) { cb(null); }
    };
    xhr.onerror = function () { cb(null); };
    xhr.send('action=networks');
  }

  function h(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function rowHtml(row, idx, networks, primary) {
    row = row || {network: '', ip: '', alias: '', mac: ''};
    var options = (networks || []).filter(function (n) {
      return reservedNetworks(primary).indexOf(n.name) === -1;
    }).map(function (n) {
      return '<option value="' + h(n.name) + '"' + (n.name === row.network ? ' selected' : '') + '>' + h(n.name) + '</option>';
    }).join('');
    return '<div class="mn-row" data-idx="' + idx + '">' +
      '<select class="mn-f-network"><option value="">(select network)</option>' + options + '</select>' +
      '<input type="text" class="mn-f-ip" placeholder="Fixed IP (optional)" value="' + h(row.ip) + '">' +
      '<input type="text" class="mn-f-alias" placeholder="Alias (optional)" value="' + h(row.alias) + '">' +
      '<input type="text" class="mn-f-mac" placeholder="MAC (optional)" value="' + h(row.mac) + '">' +
      '<button type="button" class="mn-remove-row">Remove</button>' +
      '</div>';
  }

  function currentPrimary() {
    var el = document.querySelector('select[name="contNetwork"]');
    return el ? el.value : '';
  }

  function currentPath() {
    return window.multinet ? multinet.choosePath(currentPrimary()) : 'extra';
  }

  function readRows($block) {
    var rows = [];
    $block.querySelectorAll('.mn-row').forEach(function (r) {
      var net = r.querySelector('.mn-f-network').value.trim();
      if (!net) return;
      rows.push({
        network: net,
        ip: r.querySelector('.mn-f-ip').value.trim() || null,
        alias: r.querySelector('.mn-f-alias').value.trim() || null,
        mac: r.querySelector('.mn-f-mac').value.trim() || null
      });
    });
    return rows;
  }

  var state = {rows: [], networks: []};

  function renderBlock($block) {
    var path = currentPath();
    var macDisabled = path === 'post';
    var rowsHtml = state.rows.map(function (r, i) { return rowHtml(r, i, state.networks, currentPrimary()); }).join('');
    var fragment = computeFragment();
    $block.innerHTML =
      '<div class="mn-rows">' + rowsHtml + '</div>' +
      '<button type="button" id="mn-add-row">Add network</button>' +
      ' <span class="mn-frag">path: ' + h(path) + ' &mdash; ' + h(fragment) + '</span>';
    if (macDisabled) {
      $block.querySelectorAll('.mn-f-mac').forEach(function (el) {
        el.disabled = true;
        el.title = 'MAC is not supported on the PostArgs path (primary is bridge/host/none/container:*)';
      });
    }
    $block.querySelector('#mn-add-row').addEventListener('click', function () {
      state.rows.push({network: '', ip: '', alias: '', mac: ''});
      renderBlock($block);
    });
    $block.querySelectorAll('.mn-remove-row').forEach(function (btn, i) {
      btn.addEventListener('click', function () {
        state.rows.splice(i, 1);
        renderBlock($block);
      });
    });
    $block.querySelectorAll('input, select').forEach(function (el) {
      el.addEventListener('change', function () {
        state.rows = readRows($block);
        renderBlock($block);
      });
    });
  }

  function computeFragment() {
    if (!window.multinet) return '';
    var primary = currentPrimary();
    var path = multinet.choosePath(primary);
    if (path === 'extra') {
      var macEl = document.querySelector('input[name="contMyMAC"]');
      var mac = macEl ? macEl.value.trim() : '';
      // MAC support depends on the primary's driver (ipvlan rejects it —
      // see CLAUDE.md); we don't know the driver client-side without
      // another round trip, so this preview is conservative and always
      // shows it included — api.php's save/preview actions are the real
      // source of truth and gate on the actual driver.
      return multinet.buildNetworkRun(primary, state.rows, mac || null, true);
    }
    var name = (document.querySelector('input[name="contName"]') || {}).value || '';
    var chain = multinet.buildConnectChain(name, state.rows);
    return chain === '' ? '' : '&& ' + chain;
  }

  function parseExistingIntoState() {
    var primary = currentPrimary();
    var name = (document.querySelector('input[name="contName"]') || {}).value || '';
    var extraEl = document.querySelector('input[name="contExtraParams"]');
    var postEl = document.querySelector('input[name="contPostArgs"]');
    var path = multinet.choosePath(primary);
    if (path === 'extra' && extraEl) {
      var parsed = multinet.parseExtra(extraEl.value, primary, []);
      if (parsed.found && !parsed.manually_managed) {
        state.rows = parsed.rows;
        extraEl.value = parsed.remaining; // hide our block from the visible field
      }
    } else if (path === 'post' && postEl) {
      var parsedP = multinet.parsePost(postEl.value, name, []);
      if (parsedP.found && !parsedP.manually_managed) {
        state.rows = parsedP.rows;
        postEl.value = parsedP.remaining;
      }
    }
  }

  function composeBeforeSubmit() {
    var primary = currentPrimary();
    var name = (document.querySelector('input[name="contName"]') || {}).value || '';
    var extraEl = document.querySelector('input[name="contExtraParams"]');
    var postEl = document.querySelector('input[name="contPostArgs"]');
    var path = multinet.choosePath(primary);
    if (path === 'extra' && extraEl) {
      var macEl = document.querySelector('input[name="contMyMAC"]');
      var mac = macEl ? macEl.value.trim() : '';
      var run = multinet.buildNetworkRun(primary, state.rows, mac || null, true);
      extraEl.value = multinet.serializeExtra(extraEl.value, run);
    } else if (path === 'post' && postEl) {
      var chain = multinet.buildConnectChain(name, state.rows);
      postEl.value = multinet.serializePost(postEl.value, chain);
    }
  }

  function insertBlock() {
    var macInput = document.querySelector('input[name="contMyMAC"]');
    if (!macInput) return null;
    var row = macInput.closest('dl') || macInput.closest('div') || macInput.parentElement;
    var wrapper = document.createElement(row.tagName);
    if (row.className) wrapper.className = row.className;
    var label = document.createElement('dt');
    label.textContent = 'Additional networks:';
    var body = document.createElement('dd');
    body.className = 'mn-block';
    if (row.tagName.toLowerCase() === 'dl') {
      wrapper.appendChild(label);
      wrapper.appendChild(body);
    } else {
      wrapper.appendChild(body);
    }
    row.parentNode.insertBefore(wrapper, row.nextSibling);
    return body;
  }

  function init() {
    var $block = insertBlock();
    if (!$block) { console.warn('unraid-multinet: could not find contMyMAC row to inject below'); return; }
    loadCore(function () {
      fetchNetworks(function (networks) {
        if (networks === null) {
          $block.innerHTML = '<span class="mn-err">unraid-multinet: could not reach the plugin endpoint — additional networks unavailable this page load.</span>';
          return;
        }
        state.networks = networks;
        parseExistingIntoState();
        renderBlock($block);
        var netSelect = document.querySelector('select[name="contNetwork"]');
        if (netSelect) netSelect.addEventListener('change', function () { renderBlock($block); });
        // Capture-phase listener on document fires before the form's own
        // (bubble-phase, inline onsubmit) handler on the same element —
        // capture/bubble ordering is by DOM tree position, not
        // registration order, for listeners on different targets. This
        // guarantees our fields are composed before dockerMan reads them.
        document.addEventListener('submit', function (ev) {
          var form = ev.target;
          if (form && form.querySelector && form.querySelector('input[name="contName"]')) {
            try { composeBeforeSubmit(); } catch (e) { console.error('unraid-multinet: compose failed, submitting unmodified', e); }
          }
        }, true);
      });
    });
  }

  // window.multinet.inject() lets the owner re-run this from devtools —
  // useful for testing since this container has no browser to verify the
  // real DOM shape against (see docs/SPEC.md C.2).
  loadCore(function () { window.multinet.inject = init; });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
