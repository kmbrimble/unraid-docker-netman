<?php
$pluginRoot = '/plugins/docker.netman';
?>
<script src="<?=$pluginRoot?>/docker-netman-core.js"></script>
<style>
#dnm-networks table, #dnm-containers table { width: 100%; }
#dnm-networks td, #dnm-containers td { vertical-align: top; }
.dnm-chip { padding: 2px 8px; border-radius: 10px; font-size: 0.85em; color: #fff; }
.dnm-chip-sync { background: #2e7d32; }
.dnm-chip-drift { background: #c77700; }
.dnm-chip-stopped { background: #757575; }
.dnm-chip-manual { background: #b00020; }
.dnm-row-fields input[type=text] { width: 95%; }
.dnm-fragment { font-family: monospace; font-size: 0.85em; word-break: break-all; color: #888; }
.dnm-err { color: #c62828; }
/* Same stock width:100% button issue as the injector (see DockerNetManInject.page's CSS
   comment for the live measurements that ruled out plain width:auto) — applied here
   pre-emptively to every button/input[type=button] this page renders, not just ones a
   real-browser pass has actually caught stretched. */
#dnm-networks button, #dnm-containers button, #dnm-apply-all,
#dnm-networks input[type=button], #dnm-containers input[type=button] {
  width: fit-content !important;
  min-width: 90px;
}
</style>

<table class="tablesorter shift">
  <thead><tr><th>Networks</th></tr></thead>
</table>
<div id="dnm-networks"><p class="notice">Loading&hellip;</p></div>

<table class="tablesorter shift">
  <thead><tr><th>Containers</th></tr></thead>
</table>
<p><button id="dnm-apply-all" type="button">Apply all</button></p>
<div id="dnm-containers"><p class="notice">Loading&hellip;</p></div>

<script>
var API = '<?=$pluginRoot?>/include/api.php';

function dnmBanner(msg, isError) {
  if (!msg) return;
  try {
    if (window.swal) { swal({title: isError ? 'Error' : 'Success', text: msg, type: isError ? 'error' : 'success', confirmButtonText: 'OK'}); return; }
  } catch (e) {}
  alert(msg);
}

function dnmPost(action, data, done) {
  data = data || {};
  data.action = action;
  $.post(API, data, function (resp) { done(resp); }, 'json').fail(function () {
    dnmBanner('Docker NetMan: request failed — check the browser console', true);
  });
}

function h(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

// ---- Networks table -----------------------------------------------------

function renderNetworks(networks) {
  var rows = networks.map(function (n) {
    var subnets = n.subnets.map(function (s) {
      return h(s.subnet) + (s.gateway ? ' gw ' + h(s.gateway) : '') + (s.ip_range ? ' range ' + h(s.ip_range) : '');
    }).join('<br>') || '&mdash;';
    var containers = n.containers.map(function (c) { return h(c.name) + (c.ip ? ' (' + h(c.ip) + ')' : ''); }).join('<br>') || '&mdash;';
    var protectedNet = /^(bridge|host|none)$/.test(n.name) || /^br\d/.test(n.name);
    var del = protectedNet ? '' : '<button type="button" onclick="dnmDeleteNetwork(\'' + h(n.name) + '\')">Delete</button>';
    return '<tr><td>' + h(n.name) + '</td><td>' + h(n.driver) + '</td><td>' + subnets + '</td><td>' + containers + '</td><td>' + del + '</td></tr>';
  }).join('');
  $('#dnm-networks').html(
    '<table class="tablesorter"><thead><tr><th>Name</th><th>Driver</th><th>Subnet</th><th>Containers</th><th></th></tr></thead><tbody>' + rows + '</tbody></table>' +
    '<h4>Create network</h4>' +
    '<table class="new"><tr>' +
    '<td>Name</td><td><input type="text" id="dnm-net-name" class="narrow"></td>' +
    '<td>Driver</td><td><select id="dnm-net-driver"><option value="bridge">bridge</option><option value="ipvlan">ipvlan</option><option value="macvlan">macvlan</option></select></td>' +
    '<td>Subnet</td><td><input type="text" id="dnm-net-subnet" class="narrow" placeholder="172.30.0.0/24"></td>' +
    '<td>Gateway</td><td><input type="text" id="dnm-net-gateway" class="narrow" placeholder="172.30.0.1"></td>' +
    '<td>IP range</td><td><input type="text" id="dnm-net-iprange" class="narrow" placeholder="172.30.0.128/25"></td>' +
    '<td>Parent (ipvlan/macvlan)</td><td><input type="text" id="dnm-net-parent" class="narrow" placeholder="eth0"></td>' +
    '<td><label><input type="checkbox" id="dnm-net-internal"> internal</label></td>' +
    '<td><button type="button" onclick="dnmCreateNetwork()">Create</button></td>' +
    '</tr></table><span id="dnm-net-err" class="dnm-err"></span>'
  );
}

function loadNetworks() {
  dnmPost('networks', {}, function (resp) {
    if (!resp.ok) { $('#dnm-networks').html('<p class="dnm-err">' + h(resp.error) + '</p>'); return; }
    renderNetworks(resp.networks);
  });
}

function dnmCreateNetwork() {
  dnmPost('network_create', {
    name: $('#dnm-net-name').val(),
    driver: $('#dnm-net-driver').val(),
    subnet: $('#dnm-net-subnet').val(),
    gateway: $('#dnm-net-gateway').val(),
    ip_range: $('#dnm-net-iprange').val(),
    parent: $('#dnm-net-parent').val(),
    internal: $('#dnm-net-internal').is(':checked') ? '1' : '0'
  }, function (resp) {
    if (!resp.ok) { $('#dnm-net-err').text(resp.error); return; }
    $('#dnm-net-err').text('');
    loadNetworks();
  });
}

function dnmDeleteNetwork(name) {
  if (!confirm('Delete network ' + name + '?')) return;
  dnmPost('network_delete', {name: name}, function (resp) {
    if (!resp.ok) { dnmBanner(resp.error, true); return; }
    loadNetworks();
  });
}

// ---- Containers matrix ----------------------------------------------------

var dnmContainers = {}; // name -> container object (with in-progress edits)

function dnmRowHtml(ctnName, row, idx, macDisabled) {
  row = row || {network: '', ip: '', alias: '', mac: ''};
  return '<div class="dnm-row-fields" data-idx="' + idx + '" style="margin-bottom:4px">' +
    '<input type="text" class="dnm-f-network" placeholder="network" value="' + h(row.network) + '" style="width:20%" onchange="dnmRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="dnm-f-ip" placeholder="ip (optional)" value="' + h(row.ip) + '" style="width:20%" onchange="dnmRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="dnm-f-alias" placeholder="alias (optional)" value="' + h(row.alias) + '" style="width:20%" onchange="dnmRowChanged(\'' + h(ctnName) + '\')">' +
    '<input type="text" class="dnm-f-mac" placeholder="mac (optional)" value="' + h(row.mac) + '" style="width:20%"' + (macDisabled ? ' disabled title="MAC is not supported on the PostArgs path"' : '') + ' onchange="dnmRowChanged(\'' + h(ctnName) + '\')">' +
    '<button type="button" onclick="dnmRemoveRow(\'' + h(ctnName) + '\', ' + idx + ')">Remove</button>' +
    '</div>';
}

function dnmStatusChip(c) {
  if (!c.running) return '<span class="dnm-chip dnm-chip-stopped">not running</span>';
  if (c.manually_managed) return '<span class="dnm-chip dnm-chip-manual">manually managed</span>';
  var desiredNets = c.rows.map(function (r) { return r.network; });
  var liveNets = Object.keys(c.live_networks).filter(function (n) { return n !== c.primary.split(':')[0]; });
  var inSync = desiredNets.length === liveNets.length && desiredNets.every(function (n) { return liveNets.indexOf(n) !== -1; });
  return inSync ? '<span class="dnm-chip dnm-chip-sync">in-sync</span>' : '<span class="dnm-chip dnm-chip-drift">drift</span>';
}

function dnmRenderContainer(c) {
  var macDisabled = c.path === 'post';
  var rowsHtml = c.rows.map(function (r, i) { return dnmRowHtml(c.name, r, i, macDisabled); }).join('');
  var fragment = dnmComputeFragment(c);
  var warn = c.manually_managed ? '<div class="dnm-err">' + (c.path === 'extra' ? 'ExtraParams' : 'PostArgs') + ' already contains a network block this plugin did not write &mdash; refusing to rewrite it. Remove it by hand first, or use the other path.</div>' : '';
  return '<tr id="dnm-ctn-' + h(c.name) + '">' +
    '<td><b>' + h(c.name) + '</b></td>' +
    '<td><code>' + h(c.primary) + '</code>' + (c.primary_ip ? '<br>' + h(c.primary_ip) : '') + (c.primary_mac ? '<br>' + h(c.primary_mac) : '') + '</td>' +
    '<td><code>' + h(c.path) + '</code></td>' +
    '<td>' + dnmStatusChip(c) + warn + '</td>' +
    '<td><div class="dnm-rows">' + rowsHtml + '</div>' +
      '<button type="button" onclick="dnmAddRow(\'' + h(c.name) + '\')">Add network</button>' +
      '<div class="dnm-fragment" id="dnm-frag-' + h(c.name) + '">' + h(fragment) + '</div></td>' +
    '<td class="dnm-actions">' +
      '<button type="button" onclick="dnmSave(\'' + h(c.name) + '\')">Save</button> ' +
      '<button type="button" onclick="dnmApply(\'' + h(c.name) + '\')">Apply now</button>' +
    '</td>' +
    '</tr>';
}

function dnmComputeFragment(c) {
  if (!window.dockerNetman) return '';
  if (c.path === 'extra') {
    return dockerNetman.buildNetworkRun(c.primary, c.rows, c.primary_mac || null, !!c.primary_mac_supported);
  }
  var chain = dockerNetman.buildConnectChain(c.name, c.rows);
  return chain === '' ? '' : '&& ' + chain;
}

function dnmReadRows(ctnName) {
  var rows = [];
  $('#dnm-ctn-' + ctnName + ' .dnm-row-fields').each(function () {
    var net = $(this).find('.dnm-f-network').val().trim();
    if (!net) return;
    rows.push({
      network: net,
      ip: $(this).find('.dnm-f-ip').val().trim() || null,
      alias: $(this).find('.dnm-f-alias').val().trim() || null,
      mac: $(this).find('.dnm-f-mac').val().trim() || null
    });
  });
  return rows;
}

function dnmRowChanged(ctnName) {
  var c = dnmContainers[ctnName];
  c.rows = dnmReadRows(ctnName);
  $('#dnm-frag-' + ctnName).text(dnmComputeFragment(c));
}

function dnmAddRow(ctnName) {
  var c = dnmContainers[ctnName];
  c.rows.push({network: '', ip: '', alias: '', mac: ''});
  $('#dnm-ctn-' + ctnName).replaceWith(dnmRenderContainer(c));
}

function dnmRemoveRow(ctnName, idx) {
  var c = dnmContainers[ctnName];
  c.rows.splice(idx, 1);
  $('#dnm-ctn-' + ctnName).replaceWith(dnmRenderContainer(c));
}

function dnmSave(ctnName) {
  var c = dnmContainers[ctnName];
  c.rows = dnmReadRows(ctnName);
  dnmPost('save', {name: ctnName, rows: JSON.stringify(c.rows)}, function (resp) {
    if (!resp.ok) { dnmBanner(resp.error, true); return; }
    dnmBanner('Saved. ' + (resp.path === 'extra' ? 'ExtraParams' : 'PostArgs') + ' updated in the template.', false);
    loadContainers();
  });
}

function dnmApply(ctnName) {
  dnmPost('apply', {name: ctnName}, function (resp) {
    if (!resp.ok) {
      var msg = resp.error || (resp.actions || []).filter(function (a) { return !a.ok; }).map(function (a) { return a.op + ' ' + a.network + ': ' + a.error; }).join('; ');
      dnmBanner(msg, true);
    } else {
      dnmBanner('Applied.', false);
    }
    loadContainers();
  });
}

function dnmApplyAll() {
  var names = Object.keys(dnmContainers);
  var next = function () {
    if (!names.length) { loadContainers(); return; }
    var n = names.shift();
    dnmPost('apply', {name: n}, function () { next(); });
  };
  next();
}

function renderContainers(containers) {
  dnmContainers = {};
  containers.forEach(function (c) { dnmContainers[c.name] = c; });
  var rows = containers.map(dnmRenderContainer).join('');
  $('#dnm-containers').html(
    '<table class="tablesorter"><thead><tr>' +
    '<th>Container</th><th>Primary</th><th>Path</th><th>Status</th><th>Additional networks</th><th>Actions</th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>'
  );
}

function loadContainers() {
  dnmPost('containers', {}, function (resp) {
    if (!resp.ok) { $('#dnm-containers').html('<p class="dnm-err">' + h(resp.error) + '</p>'); return; }
    renderContainers(resp.containers);
  });
}

$(function () {
  loadNetworks();
  loadContainers();
  $('#dnm-apply-all').on('click', dnmApplyAll);
});
</script>
